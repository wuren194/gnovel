    },
    "factSignals": "(?:[0-9一二三四五六七八九十百千万两]+(?:岁|年|天|万|排|号)|去年|前年|小时候|初[一二三]|高[一二三]|暑假|寒假|注册|粉丝|住在|坐在|靠窗|地下室|快递柜)",
    "sceneDynamics": {
      "minIntensityLevel": 2,
      "minNarrativeLength": 25,
      "coreActionPattern": "(?!)",
      "stickyPattern": "(?!)",
      "stickyMinCommas": 2,
      "sensoryStayPattern": "(?!)",
      "sensoryStayMinLength": 25,
      "stickyMinLength": 20,
      "enabled": false
    }
  },
