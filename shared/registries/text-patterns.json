  "word_density": {
    "name": "功能词密度",
    "scope": "narrative",
    "dialogue_exempt": true,
    "families": [
      {
        "id": "zhe",
        "name": "指示词「这」家族",
        "pattern": "这",
        "per_500_chars_limit": 3,
        "rewrite_hint": "改写方向：省略或换具体所指（那人/对方/当场/具体名词）；同段连续出现必查。→ libraries/de-ai-humanize/sections/07-function-word-density.md"
      },
      {
        "id": "shi",
        "name": "系动词「是」",
        "pattern": "是",
        "per_500_chars_limit": 4,
        "strip_affixes": [
          "于是",
          "可是",
          "但是",
          "还是",
          "不是",
          "而是",
          "只是",
          "要是",
          "倒是",
          "算是",
          "老是",
          "或是"
        ],
        "rewrite_hint": "改写方向：判断句改动作/状态/语序（他是攻→他压上来；房里是黑的→房里黑着；是他先动的手→他先动的手）。→ libraries/de-ai-humanize/sections/07-function-word-density.md"
      }
    ]
  },
  "schemaVersion": 5,
  "adjective_stack": {
    "defChain": {
      "name": "的字段语四连",
      "pattern": "(?:(?<![我你他她它们])[一-龥]{1,3}的(?:[^，。！？、\\n]{0,4})?){4,}"
    },
    "listChain": {
      "name": "顿号形容词链三连",
      "pattern": "(?:[一-龥]{1,3}的、){2,}[一-龥]{1,3}的"
    }
  },
  "diagnosticPolicy": {
    "proseQuality": {
      "minScore": 70
    },
    "subjectSentence": {
      "impersonalExistencePattern": "^(?:(?:又|却|仍然|仍|再|还是|已经|终于|忽然)(?:也|还)?)*没(?:有)?(?:(?:任何|一点儿?|一丝|半点)?(?:新的?|别的|其他的?|更多的?)?(?:消息|动静|声音|声响|脚步声|回声|人影|信号)(?=$|[，,；;]|传来|响起|出现)|(?:任何(?:新的?|别的|其他的?|更多的?)?|新的?|别的|其他的?|更多的?)通知(?=$|[，,；;]|传来|响起|出现)|通知(?=传来|响起|出现)|(?:任何人|一个人|人)(?=$|[，,；;]|应门|回答|回应|答话|说话|开口|过来|进来|出现))"
    },
    "sentenceLength": {
      "byMode": {
        "plot": 45,
        "buildup": 45,
        "mixed": 60,
        "peakscene": 60
      },
      "stickyCap": 80,
      "unpunctuatedCap": 25,
      "lengthSeverity": "info"
    },
    "sensoryDensity": {
      "minPerKHan": 10,
      "minChannels": 2,
      "minTextLength": 200,
      "severity": "info",
      "channels": {
        "触觉": "(?:冰凉|温热|粗糙|光滑|刺痛|发麻)",
        "温度": "(?:寒冷|温暖|热气|冷风)",
        "视觉": "(?:光影|明亮|昏暗|颜色|闪烁)",
        "听觉": "(?:脚步声|钟声|风声|回响)",
        "嗅觉与味觉": "(?:气味|味道|汗酸|花香|木香|饭香)"
      }
    },
    "paragraphRatio": {
