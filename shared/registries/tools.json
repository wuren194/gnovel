  "entrypoints": [
    {
      "id": "novelctl",
      "path": "scripts/novelctl.py",
      "transport": "CLI (JSON stdout)",
      "audience": "作者、工位与项目维护",
      "surface": "当前格式项目、源查询与事务、工位准备、正文及工件提交、证据、摘要、定稿与连续性；参数以 operations 注册定义为准；project export 成品导出与 preview → commit 原子事务；workflow finalize-chapter 与 continuity-complete",
      "mutations": "preview 保存完整写集；commit 需要 planHash 与明确批准；既有 Canon 受共同 diff guard 保护，关系需旧记录提案，引用中的字段定义迁移 fail closed；语义工件登记不等于批准",
      "notes": "工位的默认入口；三个通道共用 scripts/core/，novelctl 不是唯一实现"
    },
    {
      "id": "mcp-server",
      "path": "scripts/mcp_server.py",
      "transport": "stdio MCP",
      "audience": "创作客户端",
      "surface": "当前格式项目、源查询与事务、工位准备、正文及工件提交、证据、摘要、定稿与连续性；参数以 operations 注册定义为准；project export 成品导出与 preview → commit 原子事务；workflow finalize-chapter 与 continuity-complete",
      "mutations": "按 operation 效果生成注解；不接受任意 shell 或 handler",
      "notes": "与 novelctl 平级的传输层，复用同一 scripts/core/ 与批准边界"
    },
    {
      "id": "dashboard-server",
      "path": "scripts/dashboard_server.py",
      "transport": "HTTP (loopback only)",
      "audience": "本机浏览器",
      "surface": "兼容结构查询与事务；高级任务能力通过 CLI/MCP",
      "mutations": "仅 127.0.0.1/localhost 绑定；变更请求使用 HttpOnly SameSite 同源会话 cookie，兼容 X-govel-Token 头，跨源请求拒绝",
      "notes": "静态资源在 dashboard/（index.html + app.js + styles.css）；token 每次启动重新生成，不写入 /api/config 或 stdout"
    },
    {
      "id": "manuscript-import",
      "path": "scripts/core/manuscript_import.py",
      "transport": "CLI/MCP (import.preview / inspect / read / commit)",
      "audience": "作者；外部小说导入",
      "surface": "从 TXT/Markdown 自动产生分章预览，分页读原文，按 sourcePath/startLine/title 修订分章；批准后创建带正文的新项目，无须调用者生成稳定 ID 或 candidate.json。",
      "mutations": "preview 在目标旁保存冻结计划与原始字节，不创建项目；commit 核验计划、源文件和运行配置，再以独占目录发布建立新正文归属。保持 planning_required，不生成文学审校、续写范围或旧项目批准。",
      "notes": "projectRoot 是尚不存在的目标路径；原稿和预览分别保留身份。旧 review/scan/validate/create 是下列独立高级入口，不是默认全文导入路径。"
