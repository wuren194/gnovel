{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "govel": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${PLUGIN_ROOT}/skills/govel-bind/scripts/bind.py",
        "serve",
        "--host",
        "plugin",
        "--engine-root",
        "${PLUGIN_ROOT}"
      ]
    }
  }
}
